<UserControl x:Class="LDMAS.UI.Views.ExperimentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- ── Color tokens (matching MainWindow clinical dark theme) ── -->
        <SolidColorBrush x:Key="CardBgBrush"          Color="#1A2332"/>
        <SolidColorBrush x:Key="CardBorderBrush"      Color="#1E3044"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMutedBrush"       Color="#64748B"/>
        <SolidColorBrush x:Key="AccentBrush"          Color="#00B4D8"/>
        <SolidColorBrush x:Key="SuccessBrush"         Color="#10B981"/>
        <SolidColorBrush x:Key="WarningBrush"         Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerBrush"          Color="#EF4444"/>

        <!-- ── Themed TextBox Style ── -->
        <Style x:Key="ThemedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background"      Value="#111827"/>
            <Setter Property="Foreground"       Value="#E2E8F0"/>
            <Setter Property="BorderBrush"      Value="#1E3044"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="10,8"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="CaretBrush"       Value="#00B4D8"/>
            <Setter Property="Height"           Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content: DataGrid + Form Panel -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0 — PAGE HEADER                                            -->
        <!-- ============================================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28,22"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="12" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Experiments &amp; Test Results"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Create, track, and manage laboratory experiments. Submit new experiments and monitor their approval workflow."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" MaxWidth="620"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="🧪" FontSize="42"
                           VerticalAlignment="Center"
                           Opacity="0.35"/>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 1 — SPLIT LAYOUT: DataGrid (left) + Form (right)          -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Experiments List -->
                <ColumnDefinition Width="2*"/>
                <!-- Add New Form Panel -->
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Experiments DataGrid ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,20"
                    Margin="0,0,16,0">
                <DockPanel>
                    <!-- Section Header -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Recent Experiments"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="TxtExperimentCount"
                                   Text="0 records"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid x:Name="DgExperiments"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              BorderThickness="0"
                              RowBackground="Transparent"
                              AlternatingRowBackground="#141E2E"
                              FontSize="12.5"
                              CanUserResizeRows="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,10"/>
                                <Setter Property="BorderBrush" Value="#1E3044"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TITLE"        Binding="{Binding Title}"       Width="*"/>
                            <DataGridTextColumn Header="CATEGORY"     Binding="{Binding Category}"    Width="120"/>
                            <DataGridTextColumn Header="STATUS"       Binding="{Binding Status}"      Width="140"/>
                            <DataGridTextColumn Header="TECHNICIAN"   Binding="{Binding Technician}"  Width="130"/>
                            <DataGridTextColumn Header="START DATE"   Binding="{Binding StartDate}"   Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ── RIGHT: Add New Experiment Form ── -->
            <Border Grid.Column="1"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,20">
                <DockPanel LastChildFill="False">

                    <!-- Form Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="36" Height="36" CornerRadius="8"
                                    Background="#0D3B66" Margin="0,0,12,0">
                                <TextBlock Text="＋" FontSize="18"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Add New Experiment"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Height="1" Background="#1E3044"/>
                    </StackPanel>

                    <!-- Form Fields -->
                    <StackPanel DockPanel.Dock="Top">

                        <!-- Title -->
                        <TextBlock Text="EXPERIMENT TITLE"
                                   FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtExpTitle"
                                 Style="{StaticResource ThemedTextBoxStyle}"
                                 Margin="0,0,0,16"/>

                        <!-- Category -->
                        <TextBlock Text="CATEGORY"
                                   FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbExpCategory"
                                  Height="38"
                                  Background="#111827"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource CardBorderBrush}"
                                  FontSize="13"
                                  SelectedIndex="0"
                                  Margin="0,0,0,16">
                            <ComboBoxItem Content="Chemistry"/>
                            <ComboBoxItem Content="Microbiology"/>
                            <ComboBoxItem Content="Biochemistry"/>
                            <ComboBoxItem Content="Environmental"/>
                            <ComboBoxItem Content="Toxicology"/>
                            <ComboBoxItem Content="Materials Science"/>
                        </ComboBox>

                        <!-- Description -->
                        <TextBlock Text="DESCRIPTION"
                                   FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtExpDescription"
                                 Style="{StaticResource ThemedTextBoxStyle}"
                                 Height="80"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Padding="10,10"
                                 Margin="0,0,0,16"/>

                        <!-- Start Date -->
                        <TextBlock Text="START DATE"
                                   FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,6"/>
                        <DatePicker x:Name="DpExpStartDate"
                                    Height="38"
                                    Background="#111827"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    FontSize="13"
                                    Margin="0,0,0,24"/>

                    </StackPanel>

                    <!-- Submit Button -->
                    <Button DockPanel.Dock="Top"
                            x:Name="BtnSubmitExperiment"
                            Height="44"
                            Cursor="Hand"
                            Click="BtnSubmitExperiment_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SubmitBorder"
                                        CornerRadius="10"
                                        Padding="20,0"
                                        BorderThickness="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#0077B6" Offset="0"/>
                                            <GradientStop Color="#00B4D8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SubmitBorder" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧪" FontSize="15" Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Submit Experiment"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Status Feedback -->
                    <TextBlock DockPanel.Dock="Top"
                               x:Name="TxtFormStatus"
                               Text=""
                               FontSize="12"
                               Foreground="{StaticResource SuccessBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>

                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
