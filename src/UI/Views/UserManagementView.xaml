<UserControl x:Class="LDMAS.UI.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- ── Color tokens (matching MainWindow clinical dark theme) ── -->
        <SolidColorBrush x:Key="CardBgBrush"          Color="#1A2332"/>
        <SolidColorBrush x:Key="CardBorderBrush"      Color="#1E3044"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMutedBrush"       Color="#64748B"/>
        <SolidColorBrush x:Key="AccentBrush"          Color="#00B4D8"/>
        <SolidColorBrush x:Key="SuccessBrush"         Color="#10B981"/>
        <SolidColorBrush x:Key="WarningBrush"         Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerBrush"          Color="#EF4444"/>
        <SolidColorBrush x:Key="InfoBrush"            Color="#6366F1"/>

        <!-- ── Themed TextBox Style ── -->
        <Style x:Key="ThemedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background"      Value="#111827"/>
            <Setter Property="Foreground"       Value="#E2E8F0"/>
            <Setter Property="BorderBrush"      Value="#1E3044"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="10,8"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="CaretBrush"       Value="#00B4D8"/>
            <Setter Property="Height"           Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Summary Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content: DataGrid + Form -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0 — PAGE HEADER                                            -->
        <!-- ============================================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28,22"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="12" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="User Management"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Administrator-only module for managing user accounts, assigning RBAC roles, and controlling system access."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" MaxWidth="600"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock Text="👥" FontSize="42" Opacity="0.35"
                               HorizontalAlignment="Center"/>
                    <Border Background="#2D1B4E" CornerRadius="6"
                            Padding="8,4" Margin="0,6,0,0">
                        <TextBlock Text="ADMIN ONLY"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource InfoBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 1 — USER SUMMARY CARDS                                    -->
        <!-- ============================================================== -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">

            <!-- Total Users -->
            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="18,16" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="#0D3B66" Margin="0,0,12,0">
                        <TextBlock Text="👥" FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total Users" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtTotalUsers" Text="0"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Active Users -->
            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="18,16" Margin="4,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="#0D3B2A" Margin="0,0,12,0">
                        <TextBlock Text="✅" FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Active" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtActiveUsers" Text="0"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Inactive Users -->
            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="18,16" Margin="4,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="#4C2A0D" Margin="0,0,12,0">
                        <TextBlock Text="⏸" FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Inactive" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtInactiveUsers" Text="0"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Roles Assigned -->
            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="18,16" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="#2D1B4E" Margin="0,0,12,0">
                        <TextBlock Text="🛡️" FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Roles in Use" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtRoleCount" Text="0"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource InfoBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============================================================== -->
        <!-- ROW 2 — SPLIT LAYOUT: DataGrid (left) + Add User Form (right)-->
        <!-- ============================================================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*" MinWidth="330"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Users DataGrid ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24,20" Margin="0,0,16,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Registered Users"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,16"/>

                    <DataGrid x:Name="DgUsers"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              BorderThickness="0"
                              RowBackground="Transparent"
                              AlternatingRowBackground="#141E2E"
                              FontSize="12.5"
                              CanUserResizeRows="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,10"/>
                                <Setter Property="BorderBrush" Value="#1E3044"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="USERNAME"    Binding="{Binding Username}"   Width="130"/>
                            <DataGridTextColumn Header="FULL NAME"   Binding="{Binding FullName}"   Width="*"/>
                            <DataGridTextColumn Header="EMAIL"       Binding="{Binding Email}"      Width="200"/>
                            <DataGridTextColumn Header="ROLE"        Binding="{Binding Role}"       Width="120"/>
                            <DataGridTextColumn Header="DEPARTMENT"  Binding="{Binding Department}" Width="120"/>
                            <DataGridTextColumn Header="STATUS"      Binding="{Binding Status}"     Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ── RIGHT: Add New User Form ── -->
            <Border Grid.Column="1"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24,20">
                <DockPanel LastChildFill="False">

                    <!-- Form Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="36" Height="36" CornerRadius="8"
                                    Background="#2D1B4E" Margin="0,0,12,0">
                                <TextBlock Text="＋" FontSize="18"
                                           Foreground="{StaticResource InfoBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Add New User"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Height="1" Background="#1E3044"/>
                    </StackPanel>

                    <!-- Form Fields -->
                    <StackPanel DockPanel.Dock="Top">

                        <!-- First / Last Name Row -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FIRST NAME" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtFirstName" Style="{StaticResource ThemedTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="LAST NAME" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtLastName" Style="{StaticResource ThemedTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Username -->
                        <TextBlock Text="USERNAME" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtUsername" Style="{StaticResource ThemedTextBoxStyle}"
                                 Margin="0,0,0,14"/>

                        <!-- Email -->
                        <TextBlock Text="EMAIL ADDRESS" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtEmail" Style="{StaticResource ThemedTextBoxStyle}"
                                 Margin="0,0,0,14"/>

                        <!-- Role / Department Row -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ROLE" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbRole" Height="38"
                                          Background="#111827"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          BorderBrush="{StaticResource CardBorderBrush}"
                                          FontSize="13" SelectedIndex="2">
                                    <ComboBoxItem Content="Admin"/>
                                    <ComboBoxItem Content="Manager"/>
                                    <ComboBoxItem Content="Technician"/>
                                    <ComboBoxItem Content="Auditor"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DEPARTMENT" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbDepartment" Height="38"
                                          Background="#111827"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          BorderBrush="{StaticResource CardBorderBrush}"
                                          FontSize="13" SelectedIndex="0">
                                    <ComboBoxItem Content="Chemistry"/>
                                    <ComboBoxItem Content="Microbiology"/>
                                    <ComboBoxItem Content="Environmental"/>
                                    <ComboBoxItem Content="Quality Control"/>
                                    <ComboBoxItem Content="Administration"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Temp Password (informational) -->
                        <Border Background="#0A1628" CornerRadius="8"
                                Padding="14,10" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="🔐 SECURITY NOTE"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="A temporary password will be auto-generated and hashed with BCrypt. The user must change it on first login."
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- Submit Button -->
                    <Button DockPanel.Dock="Top"
                            x:Name="BtnCreateUser"
                            Height="44" Cursor="Hand"
                            Click="BtnCreateUser_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SubmitBorder"
                                        CornerRadius="10" Padding="20,0"
                                        BorderThickness="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#4338CA" Offset="0"/>
                                            <GradientStop Color="#6366F1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SubmitBorder" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="15" Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Create User Account"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Status Feedback -->
                    <TextBlock DockPanel.Dock="Top"
                               x:Name="TxtUserFormStatus" Text=""
                               FontSize="12"
                               Foreground="{StaticResource SuccessBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>

                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
