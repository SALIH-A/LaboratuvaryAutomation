<UserControl x:Class="LDMAS.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- ── Color tokens (matching MainWindow clinical dark theme) ── -->
        <SolidColorBrush x:Key="CardBgBrush"          Color="#1A2332"/>
        <SolidColorBrush x:Key="CardBorderBrush"      Color="#1E3044"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMutedBrush"       Color="#64748B"/>
        <SolidColorBrush x:Key="AccentBrush"          Color="#00B4D8"/>
        <SolidColorBrush x:Key="InfoBrush"            Color="#6366F1"/>
        <SolidColorBrush x:Key="SuccessBrush"         Color="#10B981"/>
        <SolidColorBrush x:Key="DangerBrush"          Color="#EF4444"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Controls Row -->
            <RowDefinition Height="Auto"/>
            <!-- Preview Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0 — PAGE HEADER                                            -->
        <!-- ============================================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28,22"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="12" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Reports &amp; Data Export"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Generate statistical summaries and export experiment data to CSV for external analysis in Excel, R, or Python."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" MaxWidth="600"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="📋" FontSize="42"
                           VerticalAlignment="Center"
                           Opacity="0.35"/>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 1 — FILTER & GENERATION CONTROLS                          -->
        <!-- ============================================================== -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28,24"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Date Range: Start -->
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="START DATE"
                               FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,8"/>
                    <DatePicker x:Name="DpStartDate"
                                Width="180" Height="36"
                                Background="#111827"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                FontSize="13"/>
                </StackPanel>

                <!-- Date Range: End -->
                <StackPanel Grid.Column="1" Margin="0,0,24,0">
                    <TextBlock Text="END DATE"
                               FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,8"/>
                    <DatePicker x:Name="DpEndDate"
                                Width="180" Height="36"
                                Background="#111827"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                FontSize="13"/>
                </StackPanel>

                <!-- Report Type Selector -->
                <StackPanel Grid.Column="2" Margin="0,0,24,0">
                    <TextBlock Text="REPORT TYPE"
                               FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,8"/>
                    <ComboBox x:Name="CmbReportType"
                              Width="220" Height="36"
                              Background="#111827"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource CardBorderBrush}"
                              FontSize="13"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Anomaly Report (σ Outliers)"/>
                        <ComboBoxItem Content="Monthly Summary"/>
                        <ComboBoxItem Content="Equipment Calibration Log"/>
                        <ComboBoxItem Content="Inventory Stock Report"/>
                        <ComboBoxItem Content="Full Experiment Export"/>
                    </ComboBox>
                </StackPanel>

                <!-- Spacer -->
                <Border Grid.Column="3"/>

                <!-- Generate CSV Button -->
                <Button Grid.Column="4"
                        x:Name="BtnGenerateCsv"
                        Height="40" MinWidth="180"
                        VerticalAlignment="Bottom"
                        Cursor="Hand"
                        Click="BtnGenerateCsv_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder"
                                    Background="#0D3B66"
                                    CornerRadius="10"
                                    Padding="20,0"
                                    BorderThickness="1"
                                    BorderBrush="#1A5A8A">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#115A99"/>
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#00B4D8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥" FontSize="15" Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Generate CSV"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 2 — REPORT PREVIEW / DATA GRID                            -->
        <!-- ============================================================== -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24,20">

            <DockPanel>
                <!-- Section Header -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Report Preview"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Grid.Column="1"
                               x:Name="TxtRecordCount"
                               Text="0 records"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Data Grid -->
                <DataGrid x:Name="DgReportPreview"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#141E2E"
                          FontSize="12.5"
                          CanUserResizeRows="False">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,10"/>
                            <Setter Property="BorderBrush" Value="#1E3044"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PARAMETER" Binding="{Binding ParameterName}" Width="180"/>
                        <DataGridTextColumn Header="MEASURED VALUE" Binding="{Binding MeasuredValue}" Width="140"/>
                        <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="100"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120"/>
                        <DataGridTextColumn Header="RECORDED AT" Binding="{Binding RecordedAt}" Width="160"/>
                        <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
