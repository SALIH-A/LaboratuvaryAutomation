<UserControl x:Class="LDMAS.UI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- ── Clinical Dark Theme Tokens ── -->
        <SolidColorBrush x:Key="PanelBg"           Color="#0F1B2D"/>
        <SolidColorBrush x:Key="CardBg"            Color="#1A1D2D"/>
        <SolidColorBrush x:Key="CardBorder"        Color="#2A2F42"/>
        <SolidColorBrush x:Key="InputBg"           Color="#111827"/>
        <SolidColorBrush x:Key="TextPrimary"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary"     Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted"         Color="#64748B"/>
        <SolidColorBrush x:Key="AccentBlue"        Color="#00B4D8"/>
        <SolidColorBrush x:Key="AccentHover"       Color="#334D6E"/>
        <SolidColorBrush x:Key="DangerRed"         Color="#EF4444"/>
        <SolidColorBrush x:Key="SuccessGreen"      Color="#10B981"/>

        <!-- ── Themed TextBox Style ── -->
        <Style x:Key="AuthTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground"       Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="14,10"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="CaretBrush"       Value="{StaticResource AccentBlue}"/>
            <Setter Property="Height"           Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── Themed PasswordBox Style ── -->
        <Style x:Key="AuthPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Background"      Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground"       Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="14,10"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="CaretBrush"       Value="{StaticResource AccentBlue}"/>
            <Setter Property="Height"           Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- Full-screen centered layout -->
    <Grid Background="{StaticResource PanelBg}">

        <!-- Centered Login Card -->
        <Border Width="420"
                Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="40,36"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="30" ShadowDepth="4"/>
            </Border.Effect>

            <StackPanel>

                <!-- ── Logo / Branding ── -->
                <TextBlock Text="🧪" FontSize="36"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="LDMAS"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Laboratory Data Management System"
                           FontSize="12"
                           Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,28"/>

                <!-- ── Divider ── -->
                <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,0,0,28"/>

                <!-- ── Username Field ── -->
                <TextBlock Text="USERNAME"
                           FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUsername"
                         Style="{StaticResource AuthTextBoxStyle}"
                         Margin="0,0,0,18"
                         KeyDown="Input_KeyDown"/>

                <!-- ── Password Field ── -->
                <TextBlock Text="PASSWORD"
                           FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="PwdPassword"
                             Style="{StaticResource AuthPasswordStyle}"
                             Margin="0,0,0,28"
                             KeyDown="Input_KeyDown"/>

                <!-- ── Login Button ── -->
                <Button x:Name="BtnLogin"
                        Height="48" Cursor="Hand"
                        Click="BtnLogin_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="LoginBorder"
                                    CornerRadius="10" Padding="20,0"
                                    BorderThickness="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0077B6" Offset="0"/>
                                        <GradientStop Color="#00B4D8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="LoginBorder" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="LoginBorder" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Sign In"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="White"/>
                </Button>

                <!-- ── Status / Error Message ── -->
                <TextBlock x:Name="TxtStatus"
                           Text=""
                           FontSize="12"
                           Foreground="{StaticResource DangerRed}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,16,0,0"/>

                <!-- ── Create Account Link ── -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,0">
                    <TextBlock Text="Don't have an account?"
                               FontSize="12.5"
                               Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="LnkCreateAccount"
                               Text=" Create Account"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBlue}"
                               Cursor="Hand"
                               MouseLeftButtonDown="LnkCreateAccount_Click">
                        <TextBlock.TextDecorations>
                            <TextDecoration Location="Underline">
                                <TextDecoration.Pen>
                                    <Pen Brush="{StaticResource AccentBlue}" Thickness="1"/>
                                </TextDecoration.Pen>
                            </TextDecoration>
                        </TextBlock.TextDecorations>
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
