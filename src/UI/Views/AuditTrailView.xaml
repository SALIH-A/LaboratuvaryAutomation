<UserControl x:Class="LDMAS.UI.Views.AuditTrailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- ── Color tokens (matching MainWindow clinical dark theme) ── -->
        <SolidColorBrush x:Key="CardBgBrush"          Color="#1A2332"/>
        <SolidColorBrush x:Key="CardBorderBrush"      Color="#1E3044"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMutedBrush"       Color="#64748B"/>
        <SolidColorBrush x:Key="AccentBrush"          Color="#00B4D8"/>
        <SolidColorBrush x:Key="SuccessBrush"         Color="#10B981"/>
        <SolidColorBrush x:Key="WarningBrush"         Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerBrush"          Color="#EF4444"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Filter Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Audit Log DataGrid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0 — PAGE HEADER                                            -->
        <!-- ============================================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28,22"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="12" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Audit Trail"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Immutable, read-only log of all data-modifying operations. This module cannot be edited — it ensures full laboratory compliance and traceability."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" MaxWidth="650"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock Text="🔍" FontSize="42" Opacity="0.35"
                               HorizontalAlignment="Center"/>
                    <Border Background="#4C0D1A" CornerRadius="6"
                            Padding="8,4" Margin="0,6,0,0">
                        <TextBlock Text="READ-ONLY"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 1 — SEARCH & FILTER BAR                                   -->
        <!-- ============================================================== -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24,16"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Module Filter -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="MODULE"
                               FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbFilterModule"
                              Width="160" Height="34"
                              Background="#111827"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource CardBorderBrush}"
                              FontSize="12.5"
                              SelectedIndex="0"
                              SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All Modules"/>
                        <ComboBoxItem Content="Users"/>
                        <ComboBoxItem Content="Equipment"/>
                        <ComboBoxItem Content="Experiments"/>
                        <ComboBoxItem Content="TestResults"/>
                        <ComboBoxItem Content="InventoryItems"/>
                    </ComboBox>
                </StackPanel>

                <!-- Operation Filter -->
                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <TextBlock Text="OPERATION"
                               FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbFilterOperation"
                              Width="140" Height="34"
                              Background="#111827"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource CardBorderBrush}"
                              FontSize="12.5"
                              SelectedIndex="0"
                              SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All Operations"/>
                        <ComboBoxItem Content="INSERT"/>
                        <ComboBoxItem Content="UPDATE"/>
                        <ComboBoxItem Content="DELETE"/>
                    </ComboBox>
                </StackPanel>

                <!-- Search Box -->
                <StackPanel Grid.Column="2" Margin="0,0,20,0">
                    <TextBlock Text="SEARCH USER"
                               FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,6"/>
                    <Border Background="#111827" CornerRadius="6"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            Padding="10,0" Height="34" Width="200">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔎"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1"
                                     x:Name="TxtSearchUser"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontSize="12.5"
                                     VerticalAlignment="Center"
                                     CaretBrush="{StaticResource AccentBrush}"
                                     TextChanged="Filter_Changed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Spacer -->
                <Border Grid.Column="3"/>

                <!-- Record Count -->
                <TextBlock Grid.Column="4"
                           x:Name="TxtAuditCount"
                           Text="0 entries"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,16,8"/>

                <!-- Clear Filters -->
                <Button Grid.Column="5"
                        Content="Clear Filters"
                        Height="34"
                        Padding="16,0"
                        Background="#111827"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        FontSize="12"
                        Cursor="Hand"
                        VerticalAlignment="Bottom"
                        Click="BtnClearFilters_Click"/>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 2 — AUDIT LOG DATA GRID                                    -->
        <!-- ============================================================== -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24,20">
            <DataGrid x:Name="DgAuditLog"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="Transparent"
                      Foreground="{StaticResource TextSecondaryBrush}"
                      BorderThickness="0"
                      RowBackground="Transparent"
                      AlternatingRowBackground="#141E2E"
                      FontSize="12.5"
                      CanUserResizeRows="False">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,10"/>
                        <Setter Property="BorderBrush" Value="#1E3044"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TIMESTAMP"   Binding="{Binding Timestamp}"   Width="170"/>
                    <DataGridTextColumn Header="USER"        Binding="{Binding User}"        Width="140"/>
                    <DataGridTextColumn Header="OPERATION"   Binding="{Binding Operation}"   Width="100"/>
                    <DataGridTextColumn Header="MODULE"      Binding="{Binding Module}"      Width="130"/>
                    <DataGridTextColumn Header="RECORD ID"   Binding="{Binding RecordId}"    Width="90"/>
                    <DataGridTextColumn Header="DETAILS"     Binding="{Binding Details}"     Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
