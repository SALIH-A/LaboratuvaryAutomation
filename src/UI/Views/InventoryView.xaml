<UserControl x:Class="LDMAS.UI.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- ── Color tokens (matching MainWindow clinical dark theme) ── -->
        <SolidColorBrush x:Key="CardBgBrush"          Color="#1A2332"/>
        <SolidColorBrush x:Key="CardBorderBrush"      Color="#1E3044"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMutedBrush"       Color="#64748B"/>
        <SolidColorBrush x:Key="AccentBrush"          Color="#00B4D8"/>
        <SolidColorBrush x:Key="SuccessBrush"         Color="#10B981"/>
        <SolidColorBrush x:Key="WarningBrush"         Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerBrush"          Color="#EF4444"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Summary Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Inventory DataGrid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0 — PAGE HEADER                                            -->
        <!-- ============================================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28,22"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="12" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Inventory Management"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Track reagent and consumable stock levels. Items below minimum threshold are automatically flagged."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" MaxWidth="600"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="📦" FontSize="42"
                           VerticalAlignment="Center"
                           Opacity="0.35"/>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 1 — INVENTORY SUMMARY CARDS                               -->
        <!-- ============================================================== -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">

            <!-- Total Items -->
            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,18"
                    Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="10"
                            Background="#0D3B66" Margin="0,0,14,0">
                        <TextBlock Text="📦" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total Items" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtTotalItems" Text="24"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- In Stock -->
            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,18"
                    Margin="5,0,5,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="10"
                            Background="#0D3B2A" Margin="0,0,14,0">
                        <TextBlock Text="✅" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="In Stock" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtInStock" Text="21"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Low Stock Alert -->
            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,18"
                    Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="10"
                            Background="#4C0D1A" Margin="0,0,14,0">
                        <TextBlock Text="⚠️" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Low Stock" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtLowStock" Text="3"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"
                                   Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- ============================================================== -->
        <!-- ROW 2 — INVENTORY DATA GRID                                    -->
        <!-- ============================================================== -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24,20">

            <DockPanel>
                <!-- Section Title -->
                <TextBlock DockPanel.Dock="Top"
                           Text="Reagent &amp; Consumable Inventory"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16"/>

                <!-- DataGrid -->
                <DataGrid x:Name="DgInventory"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#141E2E"
                          FontSize="12.5"
                          CanUserResizeRows="False">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,10"/>
                            <Setter Property="BorderBrush" Value="#1E3044"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ITEM NAME"      Binding="{Binding ItemName}"     Width="*"/>
                        <DataGridTextColumn Header="CATEGORY"       Binding="{Binding Category}"     Width="150"/>
                        <DataGridTextColumn Header="STOCK LEVEL"    Binding="{Binding StockLevel}"   Width="120"/>
                        <DataGridTextColumn Header="MIN THRESHOLD"  Binding="{Binding MinThreshold}" Width="130"/>
                        <DataGridTextColumn Header="UNIT"           Binding="{Binding Unit}"         Width="80"/>
                        <DataGridTextColumn Header="STATUS"         Binding="{Binding Status}"       Width="140"/>
                        <DataGridTextColumn Header="LAST RESTOCKED" Binding="{Binding LastRestocked}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
